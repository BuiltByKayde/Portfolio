# Copy this file to .env and fill in the values from
# Supabase → Project Settings → API (or the "Connect" button).
# .env is in .gitignore, so it never goes to GitHub.
# On Vercel, add the same two names under Project → Settings → Environment Variables.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
